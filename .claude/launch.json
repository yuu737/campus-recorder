{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--directory",
        "web"
      ],
      "port": 8765
    },
    {
      "name": "root",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766",
        "--directory",
        "."
      ],
      "port": 8766
    },
    {
      "name": "serve",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-I",
        "-X",
        "utf8",
        "-m",
        "recorder",
        "serve",
        "--port",
        "8767"
      ],
      "port": 8767
    }
  ]
}